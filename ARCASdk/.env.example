# =============================================================================
# ARCA SDK - Configuracion
# =============================================================================
# Copiar a .env (fuera del docroot) y completar.
# NUNCA commitear .env con credenciales reales.
# =============================================================================

# Entorno: "homo" (homologacion/testing) o "prod" (produccion)
ARCA_ENV=homo

# CUIT emisor (11 digitos, sin guiones)
ARCA_CUIT=20000000004

# Punto de venta por defecto (1-99998)
ARCA_PUNTO_VENTA=1

# Paths a certificados (formato PEM). Mantener fuera del docroot.
ARCA_CERT_PATH=/path/to/MiCertificado.pem
ARCA_KEY_PATH=/path/to/MiClavePrivada.key

# =============================================================================
# Conexion MySQL/MariaDB para cache de TA y tabla de idempotencia
# =============================================================================
ARCA_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=arca_facturador;charset=utf8mb4
ARCA_DB_USER=arca_user
ARCA_DB_PASS=changeme
ARCA_DB_PERSISTENT=false

# =============================================================================
# Timeouts (segundos, siempre finitos)
# =============================================================================
# Timeout de operaciones SOAP
ARCA_SOAP_TIMEOUT=30

# Timeout para GET_LOCK del Ticket de Acceso (WSAA)
ARCA_WSAA_LOCK_TIMEOUT=10

# Timeout para GET_LOCK de la fila de emision
ARCA_EMIT_LOCK_TIMEOUT=15

# =============================================================================
# Ticket de Acceso (WSAA) - cache compartida entre workers
# =============================================================================
# TTL del TRA en segundos (default corto, dentro de limites documentados por ARCA)
ARCA_WSAA_TRA_TTL=600
# Skew hacia atras de generationTime para tolerar drift de reloj (NTP obligatorio)
ARCA_WSAA_GENERATION_SKEW=120
# Margen de seguridad al evaluar vigencia del TA (segundos)
ARCA_WSAA_EXPIRY_MARGIN=300

# =============================================================================
# Retry policy para operaciones SOAP transitorias
# =============================================================================
ARCA_RETRY_MAX_ATTEMPTS=3
ARCA_RETRY_BASE_BACKOFF_MS=200
ARCA_RETRY_MAX_BACKOFF_MS=2000

# =============================================================================
# Idempotencia - limite de reintentos por external_id antes de requerir reset
# =============================================================================
ARCA_IDEMPOTENCIA_MAX_INTENTOS=5
# TTL (segundos) tras el cual una fila en_curso se considera zombie
ARCA_IDEMPOTENCIA_TTL_SEGUNDOS=300
